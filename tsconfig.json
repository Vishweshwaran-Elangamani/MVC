{
    "compilerOptions": {
      "target": "ES2020",
      "module": "ESNext",
      "lib": ["ES2020", "DOM"],
      "moduleResolution": "Bundler",
      "resolveJsonModule": true,
      "isolatedModules": true,
      "skipLibCheck": true,
      "noEmit": true,
  
      // 👇 This line gives you `import.meta.env`
      "types": ["vite/client"]
    },
    "include": ["src"]
  }